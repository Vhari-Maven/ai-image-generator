# AI Art Generator Configuration
# Copy this file to config.yaml and customize as needed

# Generation Settings
generation:
  # Default number of images per prompt (can be overridden via CLI)
  images_per_prompt: 1
  
  # Default service to use
  default_service: "genai"
  
  # Image quality/format settings
  image_format: "png"
  optimize_images: true
  
  # Whether to embed prompt metadata in generated images
  embed_metadata: true

# Output Settings
output:
  # Whether to create timestamped backups when overwriting existing images
  create_backups: true
  
  # Whether to organize images in subdirectories by category
  organize_by_category: true

# Google GenAI Specific Settings
genai:
  # Model to use - options:
  #   Imagen 3: imagen-3.0-generate-002
  #   Imagen 4: imagen-4.0-generate-001, imagen-4.0-fast-generate-001, imagen-4.0-ultra-generate-001
  #   Gemini:   gemini-2.5-flash-image
  model: "imagen-3.0-generate-002"

  # Default settings for all generation
  defaults:
    aspect_ratio: "1:1"
    safety_filter_level: "BLOCK_LOW_AND_ABOVE"
    person_generation: "ALLOW_ADULT"
    image_size: null  # For Imagen 4 only: "1K" or "2K" (null = default)

  # Category-specific overrides
  categories:
    background:
      aspect_ratio: "16:9"
      safety_filter_level: "BLOCK_LOW_AND_ABOVE"
      person_generation: "ALLOW_ADULT"
      image_size: null  # For Imagen 4: can use "2K" for higher resolution

    character:
      aspect_ratio: "3:4"
      safety_filter_level: "BLOCK_LOW_AND_ABOVE"
      person_generation: "ALLOW_ADULT"
      image_size: null

  # Available models and their capabilities (informational)
  models:
    "imagen-3.0-generate-002":
      family: "imagen-3"
      max_images: 8
      rpm_limit: 50
      max_resolution: "1024x1024"

    "imagen-4.0-generate-001":
      family: "imagen-4"
      max_images: 4
      rpm_limit: 20
      max_resolution: "2048x2048"
      cost_per_image: "$0.04"

    "imagen-4.0-fast-generate-001":
      family: "imagen-4"
      max_images: 4
      rpm_limit: 20
      max_resolution: "2048x2048"
      cost_per_image: "$0.04"

    "imagen-4.0-ultra-generate-001":
      family: "imagen-4"
      max_images: 4
      rpm_limit: 20
      max_resolution: "2048x2048"
      cost_per_image: "$0.06"

    "gemini-2.5-flash-image":
      family: "gemini"
      max_images: 1
      rpm_limit: 20
      max_resolution: "2048x2048"
      cost_per_image: "$0.039"

# OpenAI GPT-4o Specific Settings
openai:
  model: "gpt-image-1"

  # Default settings for all generation
  defaults:
    size: "1024x1024"
    quality: "standard"
    style: "natural"

  # Category-specific overrides
  categories:
    background:
      size: "1536x1024"  # Landscape format for backgrounds
      quality: "standard"
      style: "natural"

    character:
      size: "1024x1536"  # Portrait format for characters
      quality: "standard"
      style: "vivid"  # More vibrant for character portraits